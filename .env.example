# Anthropic API Key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite for local dev
DATABASE_URL="file:./dev.db"

# For Vercel/production: switch to PostgreSQL (free at neon.tech)
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# ---------------------------------------------------------------
# SECURITY: Both of these are REQUIRED before the app will work
# ---------------------------------------------------------------

# The password you type to log in to the tool
ADMIN_PASSWORD=choose_a_strong_password_here

# A long random secret string used to sign your session cookie.
# Generate one by running: openssl rand -hex 32
# Or use: https://generate-secret.vercel.app/32
AUTH_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
